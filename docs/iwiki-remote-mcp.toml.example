# Reference for the managed remote configuration generated by icodex when
# ICODEX_IWIKI_REMOTE_URL and ICODEX_IWIKI_REMOTE_TOKEN are set. Do not add this
# table manually: icodex writes it under the managed `iwiki` server name.
# The client does not send iwiki_id; the remote server resolves it from the
# bearer token and its configured domain grants.

[mcp_servers.iwiki]
url = "https://iwiki.example.com/mcp"
bearer_token_env_var = "IWIKI_REMOTE_TOKEN"
